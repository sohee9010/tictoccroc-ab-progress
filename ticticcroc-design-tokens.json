{
  "meta": {
    "source": "https://ui.tictoccroc.com (Storybook)",
    "themes": ["parent", "teacher"],
    "note": "parent/teacher 테마는 Brand.primary만 다르고 나머지 토큰은 공유됨"
  },
  "typography": {
    "fontFamily": "Pretendard",
    "letterSpacing": "-0.32px",
    "scale": {
      "display": {
        "tag": "div",
        "variants": ["d4R", "d4M", "d4B", "d3R", "d3M", "d3B", "d2R", "d2M", "d2B", "d1R", "d1M", "d1B"],
        "sizes_px": [40, 48, 60, 100],
        "weights": { "R": 400, "M": 500, "B": 700 },
        "lineHeight": 1.2
      },
      "headline": {
        "tag": "heading",
        "variants": ["h5R","h5M","h5B","h4R","h4M","h4B","h3R","h3M","h3B","h2R","h2M","h2B","h1R","h1M","h1B","h0R","h0M","h0B"],
        "sizes_px": [14, 16, 18, 20, 24, 36],
        "weights": { "R": 400, "M": 500, "B": 700 },
        "lineHeight": 1.2
      },
      "body": {
        "tag": "div",
        "variants": ["b5R","b5M","b4R","b4M","b3R","b3M","b2R","b2M","b1R","b1M"],
        "sizes_px": [12, 14, 15, 16, 18],
        "weights": { "R": 400, "M": 500 },
        "lineHeight": 1.2
      },
      "caption": {
        "tag": "span",
        "variants": ["c5R","c5M","c5B","c4R","c4M","c4B","c3R","c3M","c3B","c2R","c2M","c2B","c1R","c1M","c1B"],
        "sizes_px": [10, 11, 12, 13, 14],
        "weights": { "R": 400, "M": 500, "B": 700 },
        "lineHeight": 1.2
      }
    }
  },
  "spacing": {
    "layout": "8x",
    "content": "4x"
  },
  "elevation": {
    "0": "none",
    "1": "0px 2px 10px 0px rgba(0, 0, 0, 0.08)",
    "2": "0px 4px 12px 0px rgba(0, 0, 0, 0.08)",
    "3": "0px 8px 16px 0px rgba(0, 0, 0, 0.08)",
    "4": "0px 0px 16px 0px rgba(0, 0, 0, 0.20)",
    "5": "0px 1px 2px 0px rgba(0, 0, 0, 0.20), 0px 8px 16px 0px rgba(0, 0, 0, 0.08)"
  },
  "colors": {
    "shared": {
      "grey": {
        "10": "#F2F2F3", "20": "#E5E5E6", "30": "#D7D7DA", "40": "#BDBDC1",
        "50": "#A3A3A9", "60": "#7B7B84", "70": "#62626A", "80": "#4A4A4F",
        "90": "#313135", "100": "#19191A", "white": "#FFFFFF", "black": "#000000"
      },
      "background": { "primary": "#F7F7F8", "secondary": "#FAFAFC" },
      "yellow": {
        "10": "#FFFBE6", "20": "#FFF7CC", "30": "#FFF2B3", "40": "#FFEA80", "50": "#FFE14C",
        "60": "#FFD500", "70": "#FFC800", "80": "#F5B400", "90": "#EBA000", "100": "#E08E00"
      },
      "blue": {
        "10": "#DFF7FC", "20": "#C8F2F9", "30": "#B1ECF7", "40": "#82E1F2", "50": "#54D6ED",
        "60": "#26CAE8", "70": "#18C1E7", "80": "#17AFD9", "90": "#169ECB", "100": "#148ABD"
      },
      "green": {
        "10": "#E7F8ED", "20": "#D7F4E1", "30": "#C0EDD0", "40": "#A4E5BB", "50": "#7CD99D",
        "60": "#55CE80", "70": "#36BB65", "80": "#31AA66", "90": "#2D9A65", "100": "#288A63"
      },
      "pink": {
        "10": "#FEECF2", "20": "#FDE2EC", "30": "#FCCADC", "40": "#FAB2CC", "50": "#F99ABC",
        "60": "#F783AC", "70": "#F56A9C", "80": "#ED5A8E", "90": "#DE3571", "100": "#B8285B"
      },
      "classType": {
        "play": "#FAF194", "commute": "#ECD9F4", "learning": "#BDE7EF",
        "creativeArt": "#FFE4EF", "english": "#C2E5C9", "package": "#D9E3FF"
      },
      "etc": {
        "red": "#F24A45", "orange": "#FC6A00",
        "dimmed01": "rgba(0, 0, 0, 0.60)", "dimmed02": "rgba(0, 0, 0, 0.40)", "dimmed03": "rgba(0, 0, 0, 0.80)"
      }
    },
    "themes": {
      "parent": {
        "brand": {
          "primary": "#FFC800", "secondary": "#313135", "tertiary": "#7B7B84",
          "yellow": "#FFC800", "blue": "#26CAE8", "green": "#36BB65", "pink": "#F56A9C"
        },
        "brandPrimary": {
          "main": "#FFC800", "disable": "#FFFBE6", "bg": "#FFF7CC", "disableLine": "#FFF2B3",
          "pageControl": "#FFEA80", "tooltip": "#FFE14C", "line": "#FFD500", "press": "#F5B400", "text": "#EBA000"
        }
      },
      "teacher": {
        "brand": {
          "primary": "#18C1E7", "secondary": "#313135", "tertiary": "#7B7B84",
          "yellow": "#FFC800", "blue": "#26CAE8", "green": "#36BB65", "pink": "#F56A9C"
        },
        "brandPrimary": {
          "main": "#18C1E7", "disable": "#DFF7FC", "bg": "#C8F2F9", "disableLine": "#B1ECF7",
          "pageControl": "#54D6ED", "tooltip": "#82E1F2", "line": "#26CAE8", "press": "#17AFD9", "text": "#169ECB"
        }
      }
    }
  },
  "components": [
    "Accordion", "Autocomplete", "Backdrop", "Badge", "BottomSheet", "Box", "Button", "Card",
    "ChainPicker", "Checkbox", "Chip", "CircularProgressIndicator", "DatePicker", "Dialog",
    "Flexbox", "FormControlText", "Icon", "IconButton", "Label", "LineProgressIndicator", "Menu",
    "NumberKeypad", "PageControl", "Radio", "RadioGroup", "SegmentedButton", "Select", "Skeleton",
    "Slider", "Snackbar", "Switch", "Tab", "TextArea", "TextField", "Tooltip", "Typography"
  ],
  "componentSpecs": {
    "Button": {
      "tagOptions": ["button", "a", "label"],
      "variant": ["filled", "outlined", "text"],
      "color": "theme primary color (e.g. primary)",
      "size": { "default": "medium" },
      "props": ["disabled", "rounded(default true)", "fullWidth", "startAdornment", "endAdornment", "loading", "anchorButton(a tag + href)"],
      "notes": "a 태그는 네비게이션 전용, label 태그는 파일 업로드 등 특수 케이스만"
    },
    "TextField": {
      "variant": { "options": ["filled", "outlined"], "default": "outlined" },
      "size": { "options": ["large", "xLarge", "2xLarge"], "default": "large" },
      "props": ["disabled", "placeholder", "startAdornment", "endAdornment", "fullWidth", "disablePasswordVisibility"],
      "helper": "{ severity: 'success' | 'error', message?: string }",
      "states": ["default", "success(체크 아이콘)", "error(에러 메시지 표시)", "password(눈 아이콘 토글)"]
    },
    "Card": {
      "variant": { "options": ["filled", "outlined"], "default": "filled" },
      "appearance": { "options": ["kiosk", "mobile"], "default": "kiosk" },
      "props": ["disabled", "active(toggled)"]
    },
    "Badge": {
      "position": { "options": ["absolute", "static"], "default": "absolute" },
      "size": { "options": ["small", "large"], "default": "small" },
      "color": ["pink", "orange"],
      "horizontal": { "options": ["left", "right"], "default": "right" },
      "content": "string | number (보통 숫자 뱃지)"
    },
    "Chip": {
      "variant": ["filled", "outlined"],
      "props": ["selected", "disabled", "startAdornment", "endAdornment"]
    },
    "Label": {
      "variant": ["solid", "ghost", "outlined"],
      "size": { "default": "medium" },
      "color": "yellow/blue/green/pink 등 팔레트 컬러명",
      "props": ["startAdornment", "endAdornment"]
    },
    "Snackbar": {
      "variant": { "options": ["primary", "secondary", "tertiary"], "default": "primary" },
      "severity": ["success", "error"],
      "props": ["open", "transitionDuration(200)", "autoHideDuration(3000)", "hideClose", "bottom(96px)", "icon", "action", "role(alert/status)", "ariaLive(off/assertive/polite, default polite)"]
    },
    "Tab": {
      "size": { "options": ["small", "medium"], "default": "medium" },
      "shape": ["default(밑줄 인디케이터)", "chip(알약형)"],
      "props": ["scrollable", "value(required)", "disabled(개별 탭)"]
    },
    "Select": {
      "variant": { "options": ["filled", "outlined"], "default": "outlined" },
      "size": { "options": ["large", "xLarge"], "default": "large" },
      "props": ["disabled", "placeholder(default 'TEXT')", "fullWidth", "startAdornment", "open/onOpen/onClose(controlled)"]
    },
    "Dialog": {
      "props": ["fullWidth(default true)", "fullScreen(default false)", "maxWidth(default 320)", "maxHeight(default 438)", "transitionDuration(200)", "open", "onClose", "statusBarColor", "systemNavigationBarColor(default #FFFFFF)"],
      "layoutSlots": ["DialogTitle", "DialogContent", "DialogAction"]
    },
    "BottomSheet": {
      "props": ["open", "transitionDuration(200)", "enableDragCloseHandler", "onClose", "systemNavigationBarColor(default #FFFFFF)"],
      "layoutSlots": ["BottomSheetTitle", "BottomSheetContent", "BottomSheetAction"]
    }
  }
}